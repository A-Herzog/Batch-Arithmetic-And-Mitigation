    <ModelElementHoldScript id="2">
      <ModelElementSize h="50" w="100" x="300" y="100" />
      <ModelElementConnection Element="3" Type="In" />
      <ModelElementConnection Element="6" Type="Out" />
      <ModelElementHoldScriptCondition Language="Java" TimeType="Waiting time">void function(SimulationInterface sim) {
	
  double batchWaitingTime=(Double)sim.getSystem().calc("BatchWaitingTime");	
  int batchSize=16;
  
  int count=sim.getClients().count();  
  double now=sim.getSystem().getTime();
  double lastArrivalTime=(Double)sim.getSystem().calc("LastArrival");
  //sim.getSystem().log("An der Station: "+count);
  
  /* Wurde die Ausf&#252;hrung durch eine Ankunft getriggert */
  boolean wasArrival=false;
  if (count&gt;0) {
  	wasArrival=(sim.getClients().clientData(count-1,1)==0);
  	sim.getClients().clientData(count-1,1,1);
  }

  /* Kunden nur freigeben, wenn Bedienstation im Leerlauf */
  if (sim.getSystem().getWIP(4)==0) {

    /* Ein oder mehrere Batche voll? */
    if (count&gt;=batchSize) {
  	  int fullBatches=count/batchSize;
  	  //sim.getSystem().log("Freigabe von: "+(fullBatches*batchSize));
  	  for (int i=0;i&lt;fullBatches*batchSize;i++) {
  	      sim.getClients().release(i); 		
  	  }  	
    } else {
  	  if (!wasArrival &amp;&amp; lastArrivalTime+batchWaitingTime&lt;=now) {
  		/* Letzte Ankunft mehr als 60 Sekunden her. -&gt; Alle Kunden freigeben. */
  		//sim.getSystem().log("Letzte Ankunft ist mehr als 60 Sekunden her. Es werden alle "+count+" Kunden freigegeben.");
  		for (int i=0;i&lt;count;i++) {
  		  sim.getClients().release(i);
  		}
  	  }
    }
  }

  if (wasArrival) {
    //sim.getSystem().log("Aktuelle Zeit ("+now+") wird als Zeitpunkt der letzten Ankunft erfasst.");
    sim.getSystem().set("LastArrival",now);
    sim.getSystem().triggerScriptExecution(2,now+batchWaitingTime);
  }
}
</ModelElementHoldScriptCondition>
